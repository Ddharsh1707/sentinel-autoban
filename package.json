{
  "name": "sentinel-autoban",
  "version": "1.0.0",
  "description": "Detects brute-force logins from server logs, auto-bans attacking IPs, and lifts each ban exactly when it expires.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "demo": "node --env-file-if-exists=.env scripts/demo.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
