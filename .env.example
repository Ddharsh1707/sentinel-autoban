# Copy this file to .env and adjust. Every value here is a setting, not a secret.

# HTTP port
PORT=3000

# Detection rule: THRESHOLD failed logins inside WINDOW_SECONDS ban the IP
THRESHOLD=10
WINDOW_SECONDS=60

# First ban length. With ESCALATION=true the nth ban lasts n x this, capped at MAX_BAN_SECONDS
BAN_DURATION_SECONDS=60
ESCALATION=true
MAX_BAN_SECONDS=86400

# Bearer token for /api/admin/* and the dashboard. Leave empty to get a random one printed at startup.
ADMIN_TOKEN=

# true: use the first X-Forwarded-For address as the client IP (local testing, demo, behind a proxy).
# Set to false if the server is exposed directly to the internet.
TRUST_PROXY=true

# Comma-separated external log files to follow (sshd or Sentinel format), e.g. /var/log/auth.log
LOG_FILES=
TAIL_INTERVAL_MS=500

# Storage
DB_PATH=data/sentinel.db
AUTH_LOG_PATH=logs/auth.log
